# NovaGate-AIShield configuration.
#
# Copy to .env and adjust. Every value here is optional -- with no environment
# set, NovaGate binds 127.0.0.1:8000 and requires no key, which is safe for
# local use and refuses to start if you try to expose it (see below).

# ---------------------------------------------------------------- networking
# Default is loopback. Changing this to anything else REQUIRES an API key, or
# the process refuses to start -- an unauthenticated firewall that anyone can
# reach also hands them the dashboard and the audit log.
NOVAGATE_HOST=127.0.0.1
NOVAGATE_PORT=8000

# ------------------------------------------------------------ authentication
# Send as `X-API-Key: <value>` or `Authorization: Bearer <value>`.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# NOVAGATE_API_KEY=

# Force authentication even on loopback (useful when several people share a
# dev machine).
# NOVAGATE_REQUIRE_AUTH=false

# Only enable behind a proxy you control. Trusting X-Forwarded-For otherwise
# lets any client spoof a fresh rate-limit bucket by sending the header.
# NOVAGATE_TRUST_FORWARDED_FOR=false

# Serve /docs and /openapi.json. Off by default: they publish the full API
# surface, including the pass-through proxy endpoint.
# NOVAGATE_EXPOSE_DOCS=false

# Comma-separated allowlist for browser clients, e.g. https://myapp.example
# NOVAGATE_CORS_ORIGINS=

# ------------------------------------------------------------ request limits
# NOVAGATE_MAX_RAW_BYTES=64000
# NOVAGATE_MAX_PROMPT_CHARS=10000

# --------------------------------------------------------- detection tuning
# Risk index at or above which a prompt is blocked (0-10).
# NOVAGATE_BLOCK_THRESHOLD=5.0
# Risk index at or above which a prompt is flagged for human review.
# NOVAGATE_REVIEW_THRESHOLD=3.2
# Structural-anomaly score at or above which a prompt is rejected as
# machine-generated rather than human-written.
# NOVAGATE_STRUCTURAL_THRESHOLD=0.90

# --------------------------------------------------------- rate limiting
# NOVAGATE_RATE_LIMIT_ENABLED=true
# NOVAGATE_RATE_LIMIT_REQUESTS=30
# NOVAGATE_RATE_LIMIT_WINDOW=60

# --------------------------------------------------------------- audit log
# NOVAGATE_AUDIT_ENABLED=true
# NOVAGATE_AUDIT_LOG=security_audit.log
# NOVAGATE_AUDIT_MAX_BYTES=10000000
# NOVAGATE_AUDIT_BACKUP_COUNT=5
# NOVAGATE_AUDIT_PREVIEW_CHARS=120

# ------------------------------------------------- pass-through proxy (opt-in)
# Point an OpenAI-compatible client at NovaGate instead of the provider, and
# the provider key stays on this server.
# NOVAGATE_UPSTREAM_URL=https://api.openai.com/v1/chat/completions
# NOVAGATE_UPSTREAM_API_KEY=
# NOVAGATE_UPSTREAM_TIMEOUT=30

# ----------------------------------------------------------------- telemetry
# Rich console tables. Disable in production: the output is not structured and
# writing to stdout on every request is measurable overhead.
# NOVAGATE_CONSOLE_TELEMETRY=true
