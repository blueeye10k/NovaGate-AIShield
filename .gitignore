# Virtual environments. v2 listed only `venv/`, so a `.venv` -- the name pip and
# most tooling default to -- was silently untracked and ended up committed.
.venv/
venv/
env/
ENV/

# Python bytecode. v2 had .gitignore in place but had already committed
# __pycache__ directories, and .gitignore does not untrack anything.
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging and build artifacts
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Test and type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# Runtime output. The audit log can contain prompt fragments, so it must never
# be committed.
security_audit.log
security_audit.log.*
*.log
!*.example.log

# Environment and secrets. .env is ignored; .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.key

# Editors and OS cruft
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Notebooks
.ipynb_checkpoints/
